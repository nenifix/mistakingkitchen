# Mista King Kitchen — Environment Variables
# Copy this to .env and fill in your values

# Server port (Hostinger sets this automatically)
PORT=3000

# PocketBase
PB_PORT=8090

# SendGrid (for contact form emails)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxx...

# Contact form destination
CONTACT_TO=godwintext@gmail.com
FROM_EMAIL=noreply@mistakingkitchen.com
